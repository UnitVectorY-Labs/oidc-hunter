# https://github.com/UnitVectorY-Labs/repver
commands:

 - name: "pythonversion"
   params:
   - name: "version"
     pattern: "^(?P<major>0|[1-9]\\d*)\\.(?P<minor>0|[1-9]\\d*)\\.(?P<patch>0|[1-9]\\d*)$"
   targets:
   - path: "pyproject.toml"
     pattern: "^requires-python = \">=(?P<version>.*)\" # PYTHONVERSION$"
     transform: "{{major}}.{{minor}}"
   - path: ".github/workflows/build-python.yml"
     pattern: "^          python-version: '(?P<version>.*)' # PYTHONVERSION$"
   - path: "Dockerfile"
     pattern: "^FROM python:(?P<version>.*)-slim AS builder$"
   - path: "Dockerfile"
     pattern: "^FROM python:(?P<version>.*)-slim AS runtime$"
   git:
     create_branch: true
     branch_name: "repver/python-v{{version}}"
     commit: true
     commit_message: "Update Python version to v{{version}}"
     push: true
     remote: "origin"
     pull_request: "GITHUB_CLI"
     return_to_original_branch: true
     delete_branch: true

 - name: "uvydocsthemeversion"
   params:
   - name: "version"
     pattern: "^v(?P<major>0|[1-9]\\d*)\\.(?P<minor>0|[1-9]\\d*)\\.(?P<patch>0|[1-9]\\d*)$"
   targets:
   - path: "docs/_config.yml"
     pattern: "^remote_theme: UnitVectorY-Labs/uvy-docs-theme@(?P<version>.*)$"
   git:
     create_branch: true
     branch_name: "repver/uvy-docs-theme-{{version}}"
     commit: true
     commit_message: "Update uvy-docs-theme version to {{version}}"
     push: true
     remote: "origin"
     pull_request: "GITHUB_CLI"
     return_to_original_branch: true
     delete_branch: true

 - name: "mermaidversion"
   params:
   - name: "version"
     pattern: "^(?P<major>0|[1-9]\\d*)\\.(?P<minor>0|[1-9]\\d*)\\.(?P<patch>0|[1-9]\\d*)$"
   targets:
   - path: "docs/_config.yml"
     pattern: "^  version: \"(?P<version>[^\"]+)\" # MERMAIDVERSION$"
   git:
     create_branch: true
     branch_name: "repver/mermaid-{{version}}"
     commit: true
     commit_message: "Update mermaid version to v{{version}}"
     push: true
     remote: "origin"
     pull_request: "GITHUB_CLI"
     return_to_original_branch: true
     delete_branch: true
